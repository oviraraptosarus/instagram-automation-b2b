{
  "name": "instagram-autopilot",
  "version": "1.0.0",
  "description": "Smart, stealth, AI-powered Instagram automation engine with anti-ban safety limits, background runner, and live dashboard.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "login": "ts-node src/login-helper.ts",
    "dashboard": "node dist/dashboard/standalone.js",
    "clean": "rimraf dist",
    "test": "IG_PACING_SCALE=0 ts-node tests/dm-engine.test.ts && IG_PACING_SCALE=0 ts-node tests/dm-e2e.test.ts && IG_PACING_SCALE=0 ts-node tests/multi-account.test.ts",
    "test:dm": "IG_PACING_SCALE=0 ts-node tests/dm-engine.test.ts && IG_PACING_SCALE=0 ts-node tests/dm-e2e.test.ts"
  },
  "keywords": [
    "instagram",
    "automation",
    "ai",
    "openclaw",
    "anti-ban",
    "playwright",
    "stealth",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^13.0.3",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ora": "^5.4.1",
    "playwright": "^1.50.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/chalk": "^2.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}