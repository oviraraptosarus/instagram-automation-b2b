# ==========================================
# INSTAGRAM AUTOPILOT - CONFIGURATION
# ==========================================

# 1. AI CONFIGURATION
# ------------------------------------------
# Choose your AI Provider: "openclaw", "openai", "gemini", "openrouter", "ollama", or "none" (for templates only)
AI_PROVIDER=openclaw
# Your API Key for the chosen provider (OpenClaw, OpenAI, Gemini, etc.)
AI_API_KEY=your_api_key_here
# Model to use (e.g., gpt-4o-mini, gemini-2.0-flash, or your custom OpenClaw model)
AI_MODEL_NAME=gpt-4o-mini
# Custom instruction for how the AI should sound when commenting or replying
AI_TONE_INSTRUCTION="Act as a friendly, supportive creator who loves high-quality content. Keep comments short (1-2 sentences), genuine, not overly generic ('nice pic!'), use minimal emojis, and match the vibe of the post."


# 2. SAFETY & QUOTAS (CRITICAL FOR ANTI-BAN)
# ------------------------------------------
# Mode: "safe" (low limits, great for new accounts), "balanced" (medium), "active" (high limits)
SAFETY_PROFILE=balanced
# Time to sleep at night (24h format, simulate real human sleeping)
SLEEP_START_HOUR=23
SLEEP_END_HOUR=8


# 3. TARGETING & ACTIONS
# ------------------------------------------
# Hashtags to randomly explore and engage with (comma separated)
TARGET_HASHTAGS=tech,coding,software,developer,startups,photography
# Enable or Disable specific modules (true/false)
ENABLE_AUTO_LIKE_FEED=true
ENABLE_AUTO_COMMENT_FEED=true
ENABLE_AUTO_LIKE_HASHTAGS=true
ENABLE_AUTO_COMMENT_HASHTAGS=true
ENABLE_DM_AUTO_REPLY=true

# ---------------------------------------------------------------------------
# DM AUTOMATION ENGINE
# ---------------------------------------------------------------------------
# Max threads inspected per inbox sweep (keeps each sweep bounded & human).
DM_MAX_THREADS_PER_SWEEP=5

# Ignore threads whose last inbound message is older than this (hours).
DM_MAX_THREAD_AGE_HOURS=48

# Never send more than one reply to the same thread inside this window (minutes).
DM_REPLY_COOLDOWN_MINUTES=180

# Classify every inbound DM's intent before replying (HOT_LEAD, SPAM, ABUSE...).
# Set false to reply to everything (NOT recommended).
DM_QUALIFY_LEADS=true

# When a HOT_LEAD is detected, flag it for a human instead of auto-replying.
# Keep true: you do not want a bot negotiating a $1k-$10k deal.
DM_HANDOFF_ON_HOT_LEAD=true

# Intents the bot must never auto-reply to (comma separated).
DM_NEVER_REPLY_INTENTS=SPAM,ABUSE,SALES_PITCH

# 4. RELEVANCE & CONTEXT
# ------------------------------------------
# Define what your account is about. The AI reads this to decide if a post is a good match.
ACCOUNT_CONTEXT="We are a web design and SEO service agency looking to connect with small business owners, startups, and e-commerce founders."
# If true, the bot will skip posts that the AI thinks are unrelated to your ACCOUNT_CONTEXT
STRICT_RELEVANCE_CHECK=true

# 5. DASHBOARD
# ------------------------------------------
# Port for the local live web dashboard
DASHBOARD_PORT=3456
